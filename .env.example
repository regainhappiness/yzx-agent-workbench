# ============================================================================
# Agent-demo / m-knowledge-assistant 配置模板
# 复制此文件为 .env 并填入实际值
# ============================================================================


# ═══════════════════════════════════════════════════════════════
# 1. LLM 模型 Provider (至少配置一个)
# ═══════════════════════════════════════════════════════════════

# 指定使用的 Provider: auto | openai | deepseek | anthropic
# auto = 自动检测（默认，从已配置 API Key 的 Provider 中按优先级选择）
# LLM_PROVIDER=auto
# 首次启动导入时可选；导入后以 WebUI 中的运行时配置为准
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com

# WebUI 运行时配置加密主密钥。生产环境必须设置为随机长字符串；
# 本地未设置时会在 STORAGE_SQLITE_DIR 下自动生成 .runtime-config.key
# CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-secret

# OpenAI (gpt-4o-mini, gpt-4o 等)
#OPENAI_API_KEY=sk-your-openai-key-here

# DeepSeek (deepseek-chat — 推荐，便宜好用)
#DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Anthropic Claude (claude-haiku, claude-sonnet 等)
#ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here


# ═══════════════════════════════════════════════════════════════
# 2. 文档解析 — MinerU
# ═══════════════════════════════════════════════════════════════

# MinerU v4 精准解析 API Key (api.mineru.net 管理页面创建)
# 不配置时 PDF 降级到 pypdf 纯文本提取
# MINERU_API_KEY=

# MinerU API 地址 (留空使用官方地址 https://mineru.net/api/v4)
# MINERU_API_URL=https://mineru.net/api/v4

# 模型版本: vlm (推荐) | pipeline | MinerU-HTML
# MINERU_MODEL_VERSION=vlm

# 文档语言 (默认 ch 中英文)
# MINERU_LANGUAGE=ch

# MinerU Agent 轻量解析 API 地址 (免 Token, IP 限频, ≤10MB/≤20页)
# MINERU_AGENT_API_URL=https://mineru.net/api/v1


# ═══════════════════════════════════════════════════════════════
# 3. 存储层
# ═══════════════════════════════════════════════════════════════

# ── 仓储后端: sqlite (默认, 持久化) | memory (内存, 仅测试) ──
# REPOSITORY_BACKEND=sqlite

# SQLite 数据库目录 (默认 ./data, 生成 ./data/mka.db)
# STORAGE_SQLITE_DIR=./data

# 文档解析/向量化后台任务最大并发数
# DOCUMENT_TASK_CONCURRENCY=2

# 后端日志级别: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# Multi-Agent 最近对话上下文预算（近似 Token 数，超出部分会进入历史摘要）
# MULTI_AGENT_CONTEXT_MAX_TOKENS=6000

# Multi-Agent Prompt 最多直接携带的最近任务轮数
# MULTI_AGENT_MAX_HISTORY_TURNS=10

# ── 文件存储后端: local (默认) | oss ──
# STORAGE_BACKEND=local

# 本地文件存储目录
# STORAGE_LOCAL_DIR=./storage/files

# 阿里云 OSS (仅 STORAGE_BACKEND=oss 时需要)
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET_NAME=your-bucket
# OSS_ACCESS_KEY_ID=your-access-key-id
# OSS_ACCESS_KEY_SECRET=your-access-key-secret
# OSS_REGION=cn-hangzhou


# ═══════════════════════════════════════════════════════════════
# 4. Embedding — 阿里云百炼平台
# ═══════════════════════════════════════════════════════════════

# 百炼 API Key (bailian.console.aliyun.com 创建)
# 不配置时文档不会建立向量索引，问答退化为纯 LLM 对话
# BAILIAN_API_KEY=sk-xxxxxxxxxxxx

# 业务空间 ID (推荐配置，用于新版端点。不填使用旧版兼容域名 dashscope.aliyuncs.com)
# BAILIAN_WORKSPACE_ID=ws-xxxxxxxxxxxx

# 地域: cn-beijing (默认) | ap-southeast-1
# BAILIAN_REGION=cn-beijing

# Embedding 模型 (默认 text-embedding-v4)
# 文本模型: text-embedding-v4 (推荐), qwen3.7-text-embedding (最强),
#           text-embedding-v3, text-embedding-v2, text-embedding-v1
# 多模态: qwen3-vl-embedding, tongyi-embedding-vision-plus
# EMBEDDING_MODEL=text-embedding-v4

# 向量维度 (默认由模型决定: v4=1024, v3=1024, v2/v1=1536)
# 可选: v4 支持 2048/1536/1024/768/512/256/128/64
#       qwen3.7 支持 2560/2048/1536/1024/768/512/256
# EMBEDDING_DIMENSION=1024

# API 模式: openai_compatible (默认) | dashscope (支持 text_type/instruct 高级参数)
# EMBEDDING_API_MODE=openai_compatible


# ═══════════════════════════════════════════════════════════════
# 5. Milvus 向量数据库
# ═══════════════════════════════════════════════════════════════

# Milvus 地址 (docker-compose 部署)
# MILVUS_HOST=localhost

# Milvus 端口
# MILVUS_PORT=19530

# Milvus 认证 (可选, 默认无认证)
# MILVUS_USER=
# MILVUS_PASSWORD=

# 向量维度 (需与 Embedding 模型输出维度一致)
# text-embedding-v4 默认 1024 维 (可配)
# text-embedding-v2/v1 固定 1536 维
# MILVUS_VECTOR_DIM=1024


# ═══════════════════════════════════════════════════════════════
# 6. 高阶检索 — Query 改写
# ═══════════════════════════════════════════════════════════════

# 启用 Query 改写 (任意非空值即启用，使用已配置的 LLM)
# 启用后: 用户查询 → LLM 改写为多条 → 多路检索 → RRF 合并重排
# 不配置时: 使用基础单路检索
# REWRITE_MODEL=1


# ═══════════════════════════════════════════════════════════════
# 7. Tavily 网络搜索工具
# ═══════════════════════════════════════════════════════════════

# Tavily API Key (https://app.tavily.com 创建)
# 用于 src/tools/backend_api/tavily_tools.py 的搜索/提取/站点映射/爬取/研究工具
# 不配置时调用 Tavily 工具会报「缺少 TAVILY_API_KEY」
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx


# ═══════════════════════════════════════════════════════════════
# 8. MCP 外部工具
# ═══════════════════════════════════════════════════════════════

# MCP 配置文件路径 (默认 ./mcp.json)   
# 本地子进程 启动命令、参数、环境变量/streamable-http服务地址、请求头
# 在 mcp.json 里配置外部 MCP Server 列表，启动时动态发现工具注入多智能体
# MCP 默认关闭 (mcp.json 里 enabled=false)，连接失败不阻断问答
# MCP_CONFIG_PATH=./mcp.json

# Multi-Agent 会话工作区允许根目录。Windows 多个目录使用分号分隔；
# 未配置时仅允许后端启动目录及其子目录。
# MULTI_AGENT_WORKSPACE_ROOTS=D:\Project;D:\Documents

# 会话附件保存在后端本地，仅作为只读文件提供给文件/视觉 MCP。
# MULTI_AGENT_ATTACHMENT_DIR=./storage/multi_agent_attachments
# MULTI_AGENT_ATTACHMENT_MAX_MB=50

# 视觉 MCP 分析副本的最长边与上游超时结果重试次数。
# 也可在单个 MCP 配置的 env 中分别使用
# MKA_VISION_MAX_DIMENSION / MKA_MCP_RESULT_RETRIES 覆盖。
# MCP_VISION_MAX_DIMENSION=1280
# MCP_RESULT_RETRIES=1
